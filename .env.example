# Dental Marketing AI - local development
# Copy this file to .env and use your own private values.
DENTAL_APP_PASSWORD=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional text-only fallback if Gemini is temporarily unavailable.
XAI_API_KEY=

# Meta OAuth
META_CLIENT_ID=
META_CLIENT_SECRET=
META_PAGE_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000
META_REDIRECT_URI=http://localhost:3000/api/auth/meta/callback
DENTAL_MEDIA_SIGNING_SECRET=

# Optional public media endpoint and cloud storage
META_PUBLIC_MEDIA_URL=
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_ENDPOINT=

# TikTok Login Kit + Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://your-verified-domain.example/api/auth/tiktok/callback
TIKTOK_PUBLIC_MEDIA_URL=https://your-verified-domain.example

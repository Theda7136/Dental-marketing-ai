// Publicaciones de la clínica que pasan por revisión humana
// antes de programarse. El caption lo genera Grok y no se publica
// mientras el estado sea PENDING_APPROVAL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum PostStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PUBLISHED
}

enum MediaType {
  IMAGE
  VIDEO
}

model Clinic {
  id        String   @id
  name      String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String   @id @default(cuid())
  clinicId          String   @default("pilot")
  provider          String
  providerAccountId String
  name              String?  // Nombre del usuario de Meta
  accessToken       String   // Token de acceso (de usuario o de página)
  pageName          String?  // Nombre de la página de Facebook
  pageId            String?  // ID de la página de Facebook
  instagramId       String?  // ID de la cuenta de Instagram Business
  refreshToken      String?
  tokenExpiresAt    DateTime?
  grantedScopes     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([clinicId])
}
model ScheduledPost {
  id               String     @id @default(cuid())
  clinicId         String     @default("pilot")
  procedureName    String
  mediaType        MediaType  @default(IMAGE)
  deliveryFormat   String     @default("FEED")
  mediaUrl         String
  generatedCaption String
  educationalCaption String?
  commercialCaption  String?
  selectedStyle      String   @default("EDUCATIONAL")
  visualSummary      String?
  status           PostStatus @default(PENDING_APPROVAL)
  createdAt        DateTime   @default(now())
  approvedAt       DateTime?
  scheduledFor     DateTime?
  archivedAt       DateTime?
  clinicalVerifiedAt DateTime?
  facebookStatus   String     @default("PENDING")
  facebookPostId   String?
  facebookError    String?
  instagramStatus  String     @default("PENDING")
  instagramPostId  String?
  instagramError   String?
  tiktokStatus     String @default("PENDING")
  tiktokPublishId  String?
  tiktokError      String?
  tiktokPrivacy    String?
  facebookReviewOutcome  String?
  facebookReviewEvidence String?
  facebookReviewedAt     DateTime?
  instagramReviewOutcome  String?
  instagramReviewEvidence String?
  instagramReviewedAt     DateTime?
  facebookRetryCount Int @default(0)
  instagramRetryCount Int @default(0)
  facebookLastRetryAt DateTime?
  instagramLastRetryAt DateTime?

  @@index([status, createdAt])
  @@index([scheduledFor])
  @@index([clinicId, status, createdAt])
}
model BrandProfile {
  id String @id @default("default")
  clinicId String @default("pilot")
  clinicName String @default("Dental Studio")
  primaryColor String @default("#116D60")
  fontFamily String @default("SANS")
  logoDataUrl String?
  updatedAt DateTime @updatedAt
}

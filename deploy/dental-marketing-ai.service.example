[Unit]
Description=Dental Marketing AI - pilot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dental
Group=dental
WorkingDirectory=/opt/dental-marketing-ai
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
Environment=HOME=/opt/dental-marketing-ai
EnvironmentFile=/opt/dental-marketing-ai/.env
ExecStart=/usr/bin/npm run start
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0077

[Install]
WantedBy=multi-user.target
